# ScamBrake configuration
# Copy this file to .env and replace placeholders with your credentials.
# Never put real API keys in .env.example or commit .env to GitHub.

# --- AI Provider -----------------------------------------------------------
# Supported provider: gemini
SCAMBRAKE_AI_PROVIDER=gemini

# --- Google Gemini API -----------------------------------------------------
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=API_KEY_HERE


# Gemini model
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend --------------------------------------------------------------
# true  = use built-in demo fixtures
# false = perform live AI analysis
SCAMBRAKE_DEMO_MODE=false

# --- Optional: Local LM Studio ---------------------------------------------
# Retain these settings only if the application still supports LM Studio.
# LMSTUDIO_BASE_URL=http://localhost:1235/v1
# LMSTUDIO_MODEL=qwen/qwen3.5-9b