# ScamBrake configuration. Copy this file to .env and fill in your values.
# .env is gitignored - never commit real credentials.

# --- AI provider -----------------------------------------------------------
# Which backend to use for analysis: "mistral" or "lmstudio".
# If unset, ScamBrake uses Mistral when MISTRAL_API_KEY is present, else LM Studio.
# SCAMBRAKE_AI_PROVIDER=mistral

# --- Mistral API -----------------------------------------------------------
# Required for the Mistral provider. Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=
# Optional. Defaults to ministral-8b-latest (available on the free tier).
# Premier models (mistral-small-latest, mistral-medium-latest, magistral-*)
# require billing enabled on your Mistral account; without it the API returns
# HTTP 429 with a request limit of 0. Free-tier models that work:
#   ministral-8b-latest, ministral-3b-latest, open-mistral-nemo, open-mistral-7b
# MISTRAL_MODEL=ministral-8b-latest

# --- Local screenshot OCR ------------------------------------------------
# Optional full executable path; otherwise PATH and the standard Windows install are checked.
# SCAMBRAKE_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR quality gates: confidence scores are heuristics (0-100), not probabilities.
# Positive finite values only; reliable fraction must be in (0, 1].
# SCAMBRAKE_OCR_WORD_CONFIDENCE=60
# SCAMBRAKE_OCR_LINE_CONFIDENCE=80
# SCAMBRAKE_OCR_SINGLE_WORD_CONFIDENCE=90
# SCAMBRAKE_OCR_RELIABLE_FRACTION=0.5

# --- Frontend --------------------------------------------------------------
# "true" uses built-in demo fixtures; "false" runs live analysis.
SCAMBRAKE_DEMO_MODE=false
